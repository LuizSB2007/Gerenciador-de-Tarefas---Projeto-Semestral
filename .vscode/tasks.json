{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar gerenciador",
            "type": "process",
            "command": "C:\\mingw64\\bin\\mingw32-make.exe",
            "args": [
                "CC=C:/mingw64/bin/gcc.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
